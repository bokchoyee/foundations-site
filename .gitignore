.wrangler/
.dev.vars

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Computer junk
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.idea/
.vscode/*
!.vscode/extensions.json
