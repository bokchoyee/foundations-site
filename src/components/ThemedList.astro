---
import { Image } from 'astro:assets';
import { groupByTheme, readingTime, formatDate, type Post } from '../lib/posts';

interface Props { posts: Post[] }
const groups = groupByTheme(Astro.props.posts);
---
<div class="groups">
  {groups.map((g) => (
    <section class="group" aria-labelledby={`theme-${g.id}`}>
      <h3 id={`theme-${g.id}`} class="theme">{g.label}</h3>
      <ul class="list">
        {g.posts.map((post) => (
          <li>
            <a href={`/ideas/${post.id}/`} class="row">
              <div class="thumb">
                {post.data.cover && (
                  <Image
                    src={post.data.cover}
                    alt=""
                    widths={[200, 300, 400]}
                    sizes="(max-width: 760px) 96px, 136px"
                    quality={72}
                  />
                )}
              </div>
              <div class="text">
                <span class="title">{post.data.title}</span>
                <span class="summary">{post.data.summary}</span>
              </div>
              <span class="meta side">
                <span class="date">{formatDate(post.data.date)}</span>
                <span>{readingTime(post)} min</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

<style>
  .groups { display: grid; gap: clamp(40px, 6vw, 64px); }
  .group {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 32px;
    align-items: start;
  }
  .theme {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 26px;
    position: sticky;
    top: 92px;
    scroll-margin-top: 96px;
  }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .list li { border-bottom: 1px solid var(--line); }
  .row {
    display: grid;
    grid-template-columns: 136px minmax(0, 1fr) auto;
    gap: 24px;
    align-items: center;
    padding: 20px 0;
  }
  .thumb {
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s cubic-bezier(.2,.7,.2,1);
  }
  .row:hover .thumb :global(img) { transform: scale(1.05); }
  .text { display: grid; gap: 6px; min-width: 0; max-width: 600px; }
  .title {
    font-size: clamp(1.15rem, 1.9vw, 1.4rem);
    font-weight: 650;
    letter-spacing: -0.022em;
    line-height: 1.2;
    transition: color 0.15s ease;
  }
  .row:hover .title { color: var(--accent); }
  .summary { color: var(--muted); font-size: 0.97rem; line-height: 1.55; }
  .side {
    display: grid;
    justify-items: end;
    align-content: start;
    align-self: start;
    gap: 2px;
    white-space: nowrap;
    padding-top: 4px;
  }

  @media (max-width: 760px) {
    .group { grid-template-columns: 1fr; gap: 12px; }
    .theme { position: static; padding-top: 0; }
    .row {
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 16px;
      align-items: start;
      padding: 18px 0;
    }
    .thumb { border-radius: 10px; }
    .summary {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .side {
      grid-column: 2;
      justify-items: start;
      grid-auto-flow: column;
      grid-auto-columns: max-content;
      gap: 12px;
      padding-top: 0;
      margin-top: -6px;
    }
  }
</style>
