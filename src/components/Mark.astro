---
// The little logo: three blocks stacked like a foundation.
interface Props { size?: number }
const { size = 22 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" class="mark">
  <rect x="7.5" y="3.5" width="9" height="7.5" rx="1.6" fill="var(--accent)" />
  <rect x="2" y="13" width="9.5" height="7.5" rx="1.6" fill="currentColor" />
  <rect x="12.5" y="13" width="9.5" height="7.5" rx="1.6" fill="currentColor" />
</svg>
