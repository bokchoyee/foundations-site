---
// A soft, blurred photo behind the top of a page. The page section needs class="has-backdrop".
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { src?: ImageMetadata }
const { src } = Astro.props;
// Small is plenty: it gets blurred heavily anyway.
const img = src ? await getImage({ src, width: 640, format: 'webp', quality: 55 }) : undefined;
---
{img && (
  <div class="backdrop" aria-hidden="true">
    <div class="photo" style={`background-image: url(${img.src})`}></div>
  </div>
)}

<style>
  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }
  .photo {
    position: absolute;
    inset: -12%;
    background-position: center;
    background-size: cover;
    filter: blur(56px) saturate(1.35);
    opacity: var(--backdrop-opacity);
    transform: scale(1.05);
  }
  /* fades the photo into the page so the bottom edge never shows */
  .backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom,
        color-mix(in srgb, var(--bg) 10%, transparent) 0%,
        color-mix(in srgb, var(--bg) 35%, transparent) 55%,
        var(--bg) 100%);
  }
</style>
