---
import { Image } from 'astro:assets';
import { readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
  number?: number;
}
const { post, number } = Astro.props;
const { title, summary, cover, coverAlt } = post.data;
---
<a href={`/ideas/${post.id}/`} class="card">
  {cover && (
    <div class="media">
      <Image src={cover} alt={coverAlt ?? ''} widths={[480, 720, 960]} sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 380px" quality={78} />
    </div>
  )}
  <div class="body">
    <p class="meta">
      {number !== undefined && <span class="num">{String(number).padStart(2, '0')}</span>}
      {readingTime(post)} min read
    </p>
    <h3>{title}</h3>
    <p class="summary">{summary}</p>
    <span class="more">Read <span class="arrow">→</span></span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: 100%;
  }
  .media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(.2,.7,.2,1);
  }
  .card:hover .media :global(img) { transform: scale(1.035); }
  .body { display: grid; gap: 10px; }
  .num {
    color: var(--accent);
    font-weight: 650;
    margin-right: 10px;
  }
  h3 {
    font-size: 1.4rem;
    letter-spacing: -0.022em;
    line-height: 1.18;
  }
  .summary {
    color: var(--muted);
    font-size: 0.98rem;
    line-height: 1.55;
  }
  .more {
    font-size: 0.92rem;
    font-weight: 600;
    margin-top: 4px;
  }
</style>
