---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ThemedList from '../components/ThemedList.astro';
import Backdrop from '../components/Backdrop.astro';
import { getPosts } from '../lib/posts';
import { postImage } from '../lib/images';
import { site, home, quotes, partners, themes } from '../site';

const posts = await getPosts();
const themeCounts = themes
  .map((t) => ({ ...t, count: posts.filter((p) => p.data.theme === t.id).length }))
  .filter((t) => t.count > 0);
const start = home.startHere
  .map((id) => posts.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => Boolean(p));
const shownQuotes = quotes.filter((q) => q.keep);
---
<Base>
  <section class="hero-band has-backdrop">
    <Backdrop src={postImage(site.backdrop)} />
    <div class="hero wrap">
      <div class="hero-text">
        <span class="eyebrow">{home.eyebrow}</span>
        <h1>{home.headline}</h1>
        <p class="lead">{home.lead}</p>
        <div class="actions">
          <a href="#start" class="btn btn-primary">{home.primaryButton} <span class="arrow">→</span></a>
          <a href="/ideas/" class="btn btn-ghost">{home.secondaryButton}</a>
        </div>
        <p class="byline meta">{home.byline}</p>
      </div>
      <aside class="hero-card" aria-label={home.questionLabel}>
        <p class="card-label">{home.questionLabel}</p>
        <p class="question">{home.question}</p>
        <ul class="theme-links">
          {themeCounts.map((t) => (
            <li>
              <a href={`/ideas/#theme-${t.id}`}>
                <span>{t.label}</span>
                <span class="count">{t.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <section id="start" class="section wrap start">
    <div class="head">
      <h2 class="section-title">{home.startTitle}</h2>
      <p class="muted">{home.startNote}</p>
    </div>
    <div class="cards">
      {start.map((post, i) => <PostCard post={post} number={i + 1} />)}
    </div>
  </section>

  <section class="section wrap">
    <div class="head">
      <h2 class="section-title">{home.listTitle}</h2>
      <a href="/ideas/" class="link">{home.listLink} <span class="arrow">→</span></a>
    </div>
    <ThemedList posts={posts} />
  </section>

  <section class="voices flush">
    <div class="wrap">
      {shownQuotes.length > 0 && (
        <>
          <span class="eyebrow">{home.quotesLabel}</span>
          <div class="quotes">
            {shownQuotes.map((q) => (
              <figure>
                <blockquote>“{q.text}”</blockquote>
                <figcaption><strong>{q.name}</strong> · {q.role}{q.school && <>, {q.school}</>}</figcaption>
              </figure>
            ))}
          </div>
        </>
      )}
      <div class:list={['partners', { 'no-quotes': shownQuotes.length === 0 }]}>
        <p class="partners-head">{partners.heading}</p>
        <ul>
          {partners.list.map((o) => (
            <li>
              {o.page
                ? <a href={o.page}>{o.name}</a>
                : o.url ? <a href={o.url} target="_blank" rel="noopener">{o.name}</a> : o.name}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-band { overflow: hidden; }
  .hero {
    padding-top: clamp(56px, 10vw, 128px);
    padding-bottom: clamp(48px, 7vw, 88px);
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(300px, 1fr);
    gap: clamp(40px, 6vw, 88px);
    align-items: end;
  }
  .hero-text {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .hero h1 {
    font-size: clamp(2.75rem, 5.4vw, 4.75rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
    max-width: 13ch;
  }
  .hero-card {
    background: var(--glass);
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: clamp(26px, 3vw, 36px);
    display: grid;
    gap: 18px;
  }
  .card-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .question {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 1.9vw, 1.55rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
  .theme-links {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .theme-links a {
    display: flex;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
    font-weight: 550;
    transition: color 0.15s ease;
  }
  .theme-links li:last-child a { border-bottom: 0; padding-bottom: 0; }
  .theme-links a:hover { color: var(--accent); }
  .count { color: var(--faint); font-variant-numeric: tabular-nums; font-weight: 500; }
  .start { padding-top: 0; }
  .lead {
    font-size: clamp(1.125rem, 1.8vw, 1.35rem);
    line-height: 1.55;
    color: var(--muted);
    max-width: 40rem;
  }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 4px; }
  .actions .btn-ghost {
    background: var(--glass);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .byline { margin-top: 8px; }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: clamp(28px, 4vw, 44px);
    padding-top: clamp(40px, 6vw, 64px);
    border-top: 1px solid var(--line);
  }
  .link { font-weight: 600; font-size: 0.95rem; }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(24px, 3vw, 40px);
  }

  .voices {
    background: var(--surface);
    border-top: 1px solid var(--line);
    padding-block: clamp(56px, 9vw, 104px);
    margin-top: clamp(24px, 4vw, 48px);
  }
  .quotes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(28px, 5vw, 72px);
    margin-top: 28px;
  }
  /* with an odd number of quotes, the first one runs full width and larger */
  .quotes figure:first-child:nth-last-child(2n+1) { grid-column: 1 / -1; max-width: 52rem; }
  .quotes figure:first-child:nth-last-child(2n+1) blockquote { font-size: clamp(1.45rem, 2.7vw, 2.05rem); line-height: 1.35; }
  figure { margin: 0; display: grid; gap: 18px; align-content: start; }
  blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }
  figcaption { font-size: 0.92rem; color: var(--muted); }
  figcaption strong { color: var(--text); font-weight: 600; }

  .partners {
    margin-top: clamp(48px, 7vw, 80px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
    display: flex;
    gap: 16px 40px;
    flex-wrap: wrap;
    align-items: baseline;
  }
  .partners.no-quotes { margin-top: 0; padding-top: 0; border-top: 0; }
  .partners-head { font-size: 0.92rem; color: var(--muted); }
  .partners a:hover { color: var(--accent); }
  .partners ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    font-weight: 650;
    font-size: 1.05rem;
    letter-spacing: -0.015em;
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; align-items: start; }
    .cards { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .cards, .quotes { grid-template-columns: 1fr; }
    .cards { gap: 44px; }
  }
</style>
