---
import Base from '../layouts/Base.astro';
import { notFound } from '../site';
---
<Base title="Page not found">
  <section class="wrap read box">
    <span class="eyebrow">404</span>
    <h1>{notFound.heading}</h1>
    <p class="muted">{notFound.line}</p>
    <div class="actions">
      <a href="/ideas/" class="btn btn-primary">{notFound.primary}</a>
      <a href="/" class="btn btn-ghost">{notFound.secondary}</a>
    </div>
  </section>
</Base>

<style>
  .box { padding-block: clamp(80px, 14vw, 160px) 0; display: grid; gap: 18px; justify-items: start; }
  h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); letter-spacing: -0.04em; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
</style>
