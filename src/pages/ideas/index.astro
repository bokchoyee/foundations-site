---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/PageIntro.astro';
import ThemedList from '../../components/ThemedList.astro';
import { getPosts } from '../../lib/posts';
import { ideasPage } from '../../site';

const posts = await getPosts();
---
<Base title="Ideas" description={ideasPage.intro}>
  <PageIntro eyebrow="Ideas" title={ideasPage.heading} lead={ideasPage.intro} />
  <section class="wrap">
    <ThemedList posts={posts} />
  </section>
</Base>
