---
import Base from '../layouts/Base.astro';
import { site, about, partners, quotes } from '../site';
---
<Base title="About" description={about.whyThisExists}>
  <section class="wrap read top">
    <span class="eyebrow">About</span>
    <h1>Why this exists</h1>
    <p class="big">{about.whyThisExists}</p>
  </section>

  <section class="wrap read"><div class="block">
    <h2>What makes this different</h2>
    {about.whatMakesThisDifferent.map((p) => <p>{p}</p>)}
  </div></section>

  <section class="wrap read"><div class="block">
    <h2>Who's behind it</h2>
    <p>The Foundations Project is written by {site.author} in {site.location}.</p>
  </div></section>

  <section class="wrap read"><div class="block">
    <h2>{partners.heading}</h2>
    <ul class="names">
      {partners.names.map((n) => <li>{n}</li>)}
    </ul>
  </div></section>

  <section class="wrap read"><div class="block">
    <h2>What educators have said</h2>
    {quotes.map((q) => (
      <figure>
        <blockquote>“{q.text}”</blockquote>
        <figcaption><strong>{q.name}</strong> · {q.role}</figcaption>
      </figure>
    ))}
  </div></section>
</Base>

<style>
  .top {
    padding-top: clamp(56px, 9vw, 112px);
    display: grid;
    gap: 20px;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .big {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
  }
  .block {
    margin-top: clamp(48px, 7vw, 80px);
    padding-top: 32px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 16px;
  }
  .block h2 { font-size: 1.35rem; letter-spacing: -0.02em; }
  .block p {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.7;
  }
  .names {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  figure { margin: 8px 0 0; display: grid; gap: 10px; }
  blockquote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.5;
  }
  figcaption { font-size: 0.92rem; color: var(--muted); }
  figcaption strong { color: var(--text); font-weight: 600; }
</style>
