---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Backdrop from '../components/Backdrop.astro';
import { aboutMe, contact, postPage, site } from '../site';
import { postImage, assetImage } from '../lib/images';
import { isPlaceholder, hasText } from '../lib/text';

const photo = assetImage(aboutMe.photo);
---
<Base title={aboutMe.title} description={aboutMe.subheading}>
  <section class="intro-band has-backdrop">
    <Backdrop src={postImage(site.backdrop)} />
    <div class:list={['wrap', 'intro', { 'with-photo': photo }]}>
      <div class="intro-text">
        <span class="eyebrow">{aboutMe.title}</span>
        <h1>{aboutMe.heading}</h1>
        <p class:list={['lead', { placeholder: isPlaceholder(aboutMe.subheading) }]}>{aboutMe.subheading}</p>
      </div>
      {photo && (
        <div class="portrait">
          <Image src={photo} alt={aboutMe.photoAlt} widths={[360, 540, 720]} sizes="(max-width: 760px) 70vw, 360px" quality={82} loading="eager" />
        </div>
      )}
    </div>
  </section>

  <div class="wrap read body">
    <section class="bio">
      {aboutMe.bio.map((p) => <p class:list={[{ placeholder: isPlaceholder(p) }]}>{p}</p>)}
    </section>

    {hasText(aboutMe.why) && (
      <section class="block">
        <h2>{aboutMe.whyHeading}</h2>
        {aboutMe.why.map((p) => <p class:list={[{ placeholder: isPlaceholder(p) }]}>{p}</p>)}
      </section>
    )}

    {hasText(aboutMe.now) && (
      <section class="block">
        <h2>{aboutMe.nowHeading}</h2>
        {aboutMe.now.map((p) => <p class:list={[{ placeholder: isPlaceholder(p) }]}>{p}</p>)}
      </section>
    )}

    {aboutMe.interests.length > 0 && (
      <section class="block">
        <h2>{aboutMe.interestsHeading}</h2>
        <ul class="chips">
          {aboutMe.interests.map((i) => <li>{i}</li>)}
        </ul>
      </section>
    )}

    {aboutMe.links.length > 0 && (
      <section class="block">
        <ul class="links">
          {aboutMe.links.map((l) => (
            <li><a href={l.url} target="_blank" rel="noopener">{l.label} <span class="arrow">↗</span></a></li>
          ))}
        </ul>
      </section>
    )}

    <div class="actions">
      <a href="/contact/" class="btn btn-primary">{contact.heading} <span class="arrow">→</span></a>
      <a href="/mission/" class="btn btn-ghost">{postPage.missionLink}</a>
    </div>
  </div>
</Base>

<style>
  .intro-band { overflow: hidden; }
  .intro {
    padding-top: clamp(56px, 9vw, 112px);
    padding-bottom: clamp(40px, 6vw, 72px);
    max-width: calc(var(--read) + var(--gutter) * 2);
  }
  .intro.with-photo {
    max-width: calc(var(--wide) + var(--gutter) * 2);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 360px);
    gap: clamp(32px, 6vw, 80px);
    align-items: end;
  }
  .intro-text { display: grid; gap: 20px; justify-items: start; min-width: 0; }
  h1 {
    font-size: clamp(2.75rem, 7vw, 5rem);
    letter-spacing: -0.045em;
    line-height: 0.98;
  }
  .lead {
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    color: var(--muted);
    max-width: 36rem;
  }
  .portrait {
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-width: 100%;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  .portrait :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .body { display: grid; }
  .bio { display: grid; gap: 1.1em; }
  .bio p {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.65;
  }
  .block {
    margin-top: clamp(40px, 6vw, 56px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 14px;
  }
  .block h2 { font-size: 1.3rem; letter-spacing: -0.02em; }
  .block p {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    line-height: 1.7;
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    padding: 7px 14px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .links { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 24px; font-weight: 600; }
  .links a:hover { color: var(--accent); }
  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: clamp(48px, 7vw, 72px);
  }

  @media (max-width: 760px) {
    .intro.with-photo { grid-template-columns: 1fr; }
    .portrait { width: 180px; max-width: 100%; border-radius: 20px; order: -1; }
  }
</style>
